                }
              }
            },
            "description": "No administration is open, another one than you named is, or the books hold on to what you tried to change."
          }
        },
        "summary": "Suppliers, customers, banks and other contacts."
      }
    },
    "/api/docs": {
      "get": {
        "operationId": "getDocs",
        "responses": {
          "200": {
            "description": "The answer."
          }
        },
        "security": [],
        "summary": "This API described for a person."
      }
    },
    "/api/entries": {
      "get": {
        "operationId": "listEntries",
        "parameters": [
          {
            "description": "concept, posted or all (the default).",
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The code of a journal.",
            "in": "query",
            "name": "journal",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The code of an account.",
            "in": "query",
            "name": "account",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "At most 500; 100 when left out.",
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How many to skip.",
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "First day, YYYY-MM-DD.",
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Last day, YYYY-MM-DD.",
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional: the id of the administration you mean.",
            "in": "header",
            "name": "X-Themis-Administration",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryPage"
                }
              }
            },
            "description": "The answer."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No key, or not the right one."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No administration is open, another one than you named is, or the books hold on to what you tried to change."
          }
        },
        "summary": "Entries, newest last, by status, period, journal or account."
      },
      "post": {
        "operationId": "createEntry",
        "parameters": [
          {
            "description": "Optional: the id of the administration you mean.",
            "in": "header",
            "name": "X-Themis-Administration",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            },
            "description": "Taken as a concept."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No key, or not the right one."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No administration is open, another one than you named is, or the books hold on to what you tried to change."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The books refuse it; the error names why."
          }
        },
        "summary": "Send an entry. It arrives as a concept; a person posts it."
      }
    },
